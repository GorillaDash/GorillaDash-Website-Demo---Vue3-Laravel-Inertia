{
  "$schema": "https://docs.tolgee.io/cli-schema.json",
  "projectId": 10,
  "format": "YAML_ICU",
  "apiUrl": "https://multilingual.gorilladash.com",
  "parser": "vue",
  "patterns": [
    "./resources/ts/**/*.ts",
    "./resources/ts/**/*.tsx",
    "./resources/ts/**/*.vue"
  ],
  "push": {
    "filesTemplate": "./resources/locales/{languageTag}.yaml",
    "language": [
      "en-US"
    ]
  },
  "pull": {
    "path": "./resources/locales"
  }
}
