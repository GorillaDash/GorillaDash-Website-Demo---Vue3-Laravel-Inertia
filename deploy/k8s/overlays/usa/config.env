# ── .env.usa (non-secret) ─────────────────────────────────────────────────
# Becomes the `hungry-gorilla-config` ConfigMap for the USA namespace.
# Secrets (APP_KEY, DB_PASSWORD, DB_USERNAME) live in the Secret, NOT here.
APP_NAME='Hungry Gorilla USA'
APP_ENV=production
APP_DEBUG=false
APP_URL=https://hungry-gorilla-usa.gorilladashstaging.com
# TLS is terminated at Cloudflare and the Cloudflare->origin leg is HTTP, so the
# GCE LB feeds the app X-Forwarded-Proto: http. Force https for URL generation.
APP_FORCE_HTTPS=true
APP_LOCALE=en
APP_TIMEZONE=America/New_York
# Locales this deployment serves (App\Enums\Locale tags, first = default).
# Distinct from APP_LOCALE above, which stays a plain `en` for Laravel's own
# lang/ lookups. AppServiceProvider validates this at boot.
APP_LOCALES=en-US

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# The web container serves via Laravel Octane on FrankenPHP (worker mode). This
# keeps config('octane.server') and octane:reload/status matching the runtime
# driver; the actual server is launched by the image CMD (octane:frankenphp).
OCTANE_SERVER=frankenphp

# Inertia SSR (sidecar on localhost; web image has no bundle on disk)
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://127.0.0.1:13714
INERTIA_SSR_ENSURE_BUNDLE_EXISTS=false

# USA database — reached via the Cloud SQL Auth Proxy sidecar on localhost.
# CLOUD_SQL_INSTANCE is the proxy's target (works across VPCs via Google APIs).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hungry_gorilla_usa_k8s
CLOUD_SQL_INSTANCE=gorilla-dash-178800:us-west1:gorilladash-client-v2

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# Frontend public config — shared to the browser at runtime via Inertia
# (HandleInertiaRequests → page.props.config, read in resources/ts/runtimeConfig).
# Per-country, no rebuild. APP_NAME above feeds the document title via the `name`
# shared prop. website_id here (the site the frontend queries) differs from the
# server-side OAuth client (GD_WEBSITE_CLIENT_ID) below.

# GCS static assets (served via CDN). NOTE: this is a BUILD-TIME constant — Vite
# inlines it from .env.example into the bundle (deploy/Dockerfile), and the
# compiled SPA never reads this runtime ConfigMap. Kept here only as a record of
# the value in use; changing it here has no effect (edit .env.example + rebuild).
VITE_GCS_STATIC_URL=https://cdn.gorilladash.com/static/clients/hungryGorilla_

# Site identifiers
COUNTRY=US
GD_ORG_ID=
GD_WEBSITE_ID=

# GorillaDash OAuth client (client_credentials) — server-side only. Mints the
# GraphQL bearer token (client Apollo via TokenManager + SSR) and is used for
# codegen introspection. base_uri defaults to https://graphql.gorilladash.com.
GD_WEBSITE_CLIENT_ID=
GD_WEBSITE_CLIENT_SECRET=

# Google Map — runtime key, shared to the frontend via HandleInertiaRequests
# (config('services.google_maps.key')). Per-country; no rebuild needed.
GOOGLE_MAP_API_KEY=
GOOGLE_MAP_ID=

# reCAPTCHA v3 site key for a public form — runtime, per-country, because the key is
# tied to the DOMAIN (so NOT a build-time VITE_ var; one image serves every country).
# This half is PUBLIC — it ships to the browser via HandleInertiaRequests — which is
# why it belongs in this ConfigMap. Its RECAPTCHA_SECRET_KEY half is a credential and
# lives in the Secret (secret.example.yaml), never here. Blank = no captcha.
RECAPTCHA_SITE_KEY=

# Tolgee i18n — runtime, shared to the frontend via HandleInertiaRequests
# (config('services.tolgee.*')). Per-country; no rebuild needed. CDN_URL =
# published-translations endpoint (per-project hash); leave API_KEY blank in prod.
TOLGEE_CDN_URL=
TOLGEE_API_URL=https://multilingual.gorilladash.com
TOLGEE_API_KEY=

# Whether crawlers may index THIS deployment (config/seo.php -> robots.txt).
# Deliberately absent-means-closed: a staging host can only be crawled by setting
# this wrong, never by forgetting it. Flip to true on the production host only.
ROBOTS_INDEXABLE=false
# Comma-separated user-agent tokens allowed in even when the above is false (e.g.
# "SiteAuditBot" for a Semrush audit of the staging host). Stated blank rather than
# omitted so `php artisan env:use` can carry it, and so turning one on is an edit
# rather than remembering the key exists.
ROBOTS_ALLOWED_BOTS=

# The Cloudflare zone fronting this country (non-secret; the API token lives in the
# Secret and in the CLOUDFLARE_API_TOKEN repo secret). deploy.sh purges by zone id;
# the app reads it via config('services.cloudflare.zone_id') for CMS-publish purges.
CLOUDFLARE_ZONE_ID=
# The public hostname(s) Cloudflare serves for this country, space-separated. Both
# deploy.sh (step 5a) and the cloudflare-rules workflow converge exactly these onto
# deploy/cloudflare/rules.sh — the rules are per-host because the zone is shared.
CLOUDFLARE_HOSTS=hungry-gorilla-usa.gorilladashstaging.com
