<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Routes are registered at boot from this, so the suite must not inherit a
             developer's local APP_LOCALES: a multilingual .env would turn every page
             assertion into a 302. LocaleRoutingTest re-registers the routes itself to
             exercise the multilingual shape. -->
        <env name="APP_LOCALES" value="en-US"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Keep the suite offline: the keyed sub-routes bake their page's slugs at
             route registration (routes/web.php), which runs at every test boot BEFORE
             any Mockery fake exists — with a real base URI that would be a live GD call
             per test. An unreachable address fails instantly and the lookup degrades
             to WebsitePages::FALLBACK, which is what the default-slug tests expect. -->
        <env name="GD_WEBSITE_BASE_URI" value="http://127.0.0.1:9"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <!-- Pin the captcha OFF for the suite. Without these, a machine with keys
             in .env would verify for real (the package talks to Google over its own
             transport, so Http::fake() cannot stop it) and every form test would
             need a live token. App\Services\Recaptcha is gated on the SECRET. -->
        <env name="RECAPTCHA_SITE_KEY" value=""/>
        <env name="RECAPTCHA_SECRET_KEY" value=""/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Ray is a dev dependency here; without this every test pays a connection
             attempt to a Ray app that CI (and most machines) never runs. -->
        <env name="RAY_ENABLED" value="false"/>
    </php>
</phpunit>
