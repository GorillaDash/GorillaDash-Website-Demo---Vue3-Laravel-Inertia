# ── Layer 3 of `php artisan env:use usa`: local USA overrides ───────────────
#
# Copy to .env.local.usa. Highest precedence: these beat .env.local.shared AND
# the values pulled from deploy/k8s/overlays/usa/config.env.
#
# Only put a key here when it differs per country AND the overlay's answer is
# wrong on a developer machine.

# Herd host for this country.
APP_URL=http://acme-usa.test

# Local database for this country; the overlay's is the Cloud SQL one.
DB_DATABASE=acme_usa

# The secret half of the overlay's RECAPTCHA_SITE_KEY. It is a secret, so it
# lives here and never in the tracked overlay.
RECAPTCHA_SECRET_KEY=

# A Tolgee API key turns on in-context translation locally. Production leaves it
# blank on purpose, which is why this overrides the overlay rather than reading
# it. Uncomment to use.
# TOLGEE_API_KEY=
