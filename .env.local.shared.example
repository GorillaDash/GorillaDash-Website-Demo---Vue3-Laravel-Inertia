# ── Layer 1 of `php artisan env:use`: local defaults, every country ─────────
#
# Copy to .env.local.shared and fill in. Everything here is local-only and the
# same whichever country you are working on. Layer 2 (the country's deployment
# overlay, allowlisted) and layer 3 (.env.local.<country>) both override it.
#
# Do not edit .env directly — env:use regenerates it from these layers.

APP_ENV=local
APP_DEBUG=true

# Leave blank on a fresh checkout and run `php artisan key:generate` after the
# first switch, then paste the key here. env:use carries an existing key across
# switches so sessions and encrypted columns survive, but only this file makes
# that independent of whatever .env happened to be there before.
APP_KEY=

APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local MySQL (Herd). DB_DATABASE is per-country and lives in layer 3; the
# overlay's DB_HOST/CLOUD_SQL_INSTANCE point at the Cloud SQL proxy and are
# deliberately outside the identity allowlist.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Herd serves .test over http, so a secure-only cookie is never stored and you
# get a session that silently resets on every request. The overlays set this
# true for production, which is one reason the allowlist exists.
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

OCTANE_SERVER=frankenphp

# No SSR sidecar locally; vite dev renders SSR itself.
INERTIA_SSR_ENABLED=false

# Build-time (Vite inlines it into the bundle) and identical for every country,
# so it belongs here rather than in the per-country identity allowlist.
VITE_GCS_STATIC_URL=https://cdn.gorilladash.com/static/clients/hungryGorilla_

# Edge API token. deploy/deploy.sh reads it from the repo .env as a local
# convenience; the matching non-secret zone id comes from the country's overlay.
CLOUDFLARE_API_TOKEN=
