{
  "$schema": "https://www.schemastore.org/package.json",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "vite build",
    "build:ssr": "vite build && vite build --ssr",
    "static:upload": "gcloud storage rsync --recursive public/static gs://gorilladash-static-files/static/clients/hungryGorilla_",
    "dev": "vite",
    "format": "prettier --write resources/",
    "format:check": "prettier --check resources/",
    "lint": "node bin/tailwind-scale.mjs --fix && oxlint --fix",
    "lint:check": "node bin/tailwind-scale.mjs --check && oxlint",
    "types:check": "vue-tsc --noEmit",
    "codegen": "NODE_OPTIONS=\"--import tsx\" graphql-codegen --require dotenv/config --config ./resources/ts/codegen.ts dotenv_config_path=.env",
    "prepare": "husky",
    "tw:scale": "node bin/tailwind-scale.mjs --fix",
    "tw:scale:check": "node bin/tailwind-scale.mjs"
  },
  "devDependencies": {
    "@fontsource/instrument-sans": "^5.2.8",
    "@fontsource/oswald": "^5.2.8",
    "@fontsource/pacifico": "^5.2.7",
    "@graphql-codegen/cli": "^6.3.1",
    "@graphql-codegen/client-preset": "^6.0.1",
    "@graphql-codegen/near-operation-file-preset": "^5.2.1",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.0",
    "@laravel/vite-plugin-wayfinder": "^0.1.3",
    "@types/google.maps": "^3.65.1",
    "@types/node": "^22.13.5",
    "dotenv": "^17.4.2",
    "fontaine": "^0.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxlint": "^1.36.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "schema-dts": "^2.0.0",
    "tsx": "^4.22.4",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vue-tsc": "^3.3.5"
  },
  "dependencies": {
    "@apollo/client": "^4.0.10",
    "@googlemaps/js-api-loader": "^2.1.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@inertiajs/vite": "^3.0.0",
    "@inertiajs/vue3": "^3.0.0",
    "@tailwindcss/vite": "^4.1.11",
    "@tolgee/format-icu": "^7.1.1",
    "@tolgee/vue": "^7.1.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vueuse/core": "^14.3.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.0.1",
    "crypto-hash": "^4.0.1",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.6",
    "laravel-vite-plugin": "^3.1",
    "pinia": "^3.0.4",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.1.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vue": "^3.5.13"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.9.5",
    "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
    "lightningcss-linux-x64-gnu": "^1.29.1"
  }
}
