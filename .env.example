APP_NAME="Hungry Gorilla"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Force generated URLs to https. Enable in envs where a TLS-terminating CDN
# (Cloudflare) reaches the origin over HTTP and the LB resets X-Forwarded-Proto.
APP_FORCE_HTTPS=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Laravel Octane driver. Production serves via FrankenPHP worker mode (see
# deploy/Dockerfile). Local `composer dev` uses `php artisan serve`, not Octane,
# so this only matters if you run `php artisan octane:frankenphp` locally.
OCTANE_SERVER=frankenphp

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# GCS static assets (served via CDN). Build-time: Vite inlines this from THIS file
# into the bundle (deploy/Dockerfile copies .env.example → .env before building);
# resources/ts/lib/gcs.ts reads it. Same CDN for every country (bucket path is
# per-client), so build-time is fine. The compiled SPA never reads the k8s
# config.env, so this only takes effect when set here.
VITE_GCS_STATIC_URL=https://cdn.gorilladash.com/static/clients/hungryGorilla_

# Tolgee i18n — runtime, per-country (config/services.php → HandleInertiaRequests
# → page.props.config → runtimeConfig; see resources/ts/plugins/tolgee.ts).
# CDN_URL: published-translations endpoint on the GD localization backend
# (per-project hash). API_URL/API_KEY: in-context editing in dev only — leave the
# key blank in production. All optional: with none set, keys render via their `default`.
#
# API_KEY is ALSO what the Tolgee CLI authenticates with (`pnpm run tolgee -- sync`,
# via bin/tolgee.sh). It is a credential, so it stays blank in this tracked file and
# the real value goes in .env.local.shared, which is gitignored. Never put it in
# .tolgeerc — that file is tracked, and a key committed there is published with the
# repository.
TOLGEE_CDN_URL=
TOLGEE_API_URL=https://multilingual.gorilladash.com
TOLGEE_API_KEY=

# Locales this deployment serves — comma-separated App\Enums\Locale values, first
# one is the default (see config/i18n.php). One entry = monolingual: no /{locale}
# URL prefix, no language switcher, links unchanged. Two or more turns both on, so
# `en-US,ja-JP` serves /en/menu and /jp/menu. Distinct from APP_LOCALE above, which
# is Laravel's own locale for lang/ lookups. A value not in the enum fails the boot.
APP_LOCALES=en-US

# Frontend public config — runtime, per-country, shared to the browser via Inertia
# (HandleInertiaRequests → page.props.config, read in resources/ts/runtimeConfig).
# APP_NAME above feeds the document title via the `name` shared prop. website_id
# (the site the frontend queries) differs from the server-side OAuth client
# (GD_WEBSITE_CLIENT_ID) below.
COUNTRY=US
GD_ORG_ID=
GD_WEBSITE_ID=

# GorillaDash OAuth client (client_credentials) — server-side only, not exposed to
# the browser. Mints the GraphQL bearer token (client Apollo via TokenManager + SSR)
# and is used for codegen introspection. base_uri defaults to
# https://graphql.gorilladash.com (override with GD_WEBSITE_BASE_URI).
GD_WEBSITE_CLIENT_ID=
GD_WEBSITE_CLIENT_SECRET=

# SSR-only GraphQL base URL override (no trailing slash, no /graphql — Apollo
# appends /graphql). When set, the Inertia SSR renderer calls this instead of the
# public graphqlURL, so server-side render traffic can hit the GD API's direct /
# internal Cloud Run URL and skip the public LB + Cloud Armor. Browser is unaffected.
# NOTE: normally leave this UNSET everywhere — the public LB's Cloud CDN serves
# SSR's APQ GETs from cache (~23ms hot vs ~220ms direct, measured 2026-07-03) and
# shields AlloyDB under load; direct Cloud Run has no CDN. Reserved for a future
# private-networking setup (internal ALB) or debugging.
GD_GRAPHQL_SSR_URL=

# SSR edge identity key (SSR-only, optional). When set, the SSR renderer sends it
# as an x-gd-edge-key header on every GraphQL call; a Cloud Armor allow rule
# (priority 800 on graphql-api-bot-protection) matches it so SSR can never be
# caught by the UA-based bot-deny rules. Value lives in hungry-gorilla-secret per
# namespace and MUST equal the Armor rule's value; canonical copy in Secret
# Manager (gd-ssr-edge-key, project gorilla-dash-178800). Leave empty for local
# dev (SSR then rides the policy's default-allow, same as before).
GD_SSR_EDGE_KEY=

# Google Maps (browser JS API key; restrict by HTTP referrer). Runtime-only:
# shared to the frontend via HandleInertiaRequests (config('services.google_maps.key')),
# so it comes from each deployment's config.env — per country, no rebuild needed.
# Set your own for local dev.
GOOGLE_MAP_API_KEY=
# Map ID — required by AdvancedMarkerElement (the map's pins). Create one in the
# Google Cloud console (Maps > Map management). Leaving it blank falls back to Google's
# DEMO_MAP_ID, which is fine for dev but shows a development watermark — set a real one
# for any deployment. (The fallback only works because GoogleMap.vue tests the value
# with `||`: a blank-but-present line arrives as '' and `??` would pass it straight to
# Google, which then renders NO markers and shows "This page can't load Google Maps
# correctly". Found 2026-09-11.)
GOOGLE_MAP_ID=

# reCAPTCHA v3, for a public form (none in the starter itself). Per-country, runtime:
# the site key is tied to the DOMAIN, so it must not be a build-time VITE_ var — one
# image serves every country. The site key is public and is shared to the browser via
# HandleInertiaRequests; the SECRET is server-side only and belongs in the k8s Secret,
# not the ConfigMap. Blank = no captcha.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# robots.txt, served from config (config/seo.php) instead of public/robots.txt so
# one image can say different things per host. Runtime-only, per deployment:
# false (the default) = "Disallow: /", true = crawlable. ROBOTS_SITEMAP, when set,
# appends a `Sitemap:` line — nothing serves a sitemap yet.
ROBOTS_INDEXABLE=false
# Comma-separated user-agent tokens allowed in even when the above is false (e.g.
# "SiteAuditBot" for Semrush Site Audit). Each is emitted as its own robots.txt
# group; a crawler obeys only its most specific matching group, so a named bot
# never sees the blanket Disallow.
ROBOTS_ALLOWED_BOTS=
ROBOTS_SITEMAP=

# Cloudflare, the edge in front of this deployment. ZONE_ID is non-secret and
# per-deployment (it lives in each country's config.env); the token is a secret and
# belongs in hungry-gorilla-secret / the GitHub repo secret, never in a committed overlay.
# deploy/cloudflare/apply-rules.sh discovers the zone from the hostname, so it needs
# only the token; deploy.sh purges by zone id and needs both.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
